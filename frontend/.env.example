# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
DATABASE_URL=

# Google Places Text Search (New); absent uses built-in demo contractors.
GOOGLE_PLACES_API_KEY=
# Twilio account SID for SMS and voice.
TWILIO_ACCOUNT_SID=
# Twilio auth token; also enables webhook signature validation.
TWILIO_AUTH_TOKEN=
# Twilio sending phone number in E.164 format.
TWILIO_PHONE_NUMBER=
# Resend API key for outbound email.
RESEND_API_KEY=
# Verified Resend sender address.
RESEND_FROM_EMAIL=
# Optional inbox for contractor email replies.
RESEND_REPLY_TO=
# Public origin used for Twilio callbacks and signature validation.
APP_BASE_URL=
# Optional override for every contractor SMS or call destination.
DEMO_CONTRACTOR_PHONE=
# Optional override for every contractor email destination.
DEMO_CONTRACTOR_EMAIL=
# Optional Bearer token required by the rent reminder cron endpoint.
CRON_SECRET=

# Supabase (Project Settings → API). Without these the app runs in demo mode.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push (optional). Generate a matching key pair with web-push generate-vapid-keys.
# Public key is included in the browser build; set it before building.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# Private key stays on the server. Never commit real keys.
VAPID_PRIVATE_KEY=
# Contact address for push providers, e.g. mailto:you@example.com.
# Missing VAPID values skip push delivery (dry run).
VAPID_SUBJECT=
